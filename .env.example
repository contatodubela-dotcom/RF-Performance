# RF Performance Comercial — Variáveis de Ambiente
# Copie este arquivo para .env e preencha com os valores do seu projeto Supabase

# URL pública do projeto Supabase (seguro no frontend)
VITE_SUPABASE_URL=https://seu-projeto.supabase.co

# Chave anônima pública do projeto Supabase (seguro no frontend)
VITE_SUPABASE_ANON_KEY=sua-chave-anon-publica

# ============================================================
# ATENÇÃO — NUNCA inclua no frontend (nem no .env):
# - SUPABASE_SERVICE_ROLE_KEY  (somente em Edge Functions)
# - Senha do banco de dados
# - Secrets de outros projetos (EPSA Core, MCI Consórcio)
# - JWT secret
# ============================================================
